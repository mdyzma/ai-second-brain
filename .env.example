# Copy to .env (just setup does this for you). Never commit .env.
# Database shared by dbmate and the backend (dev container from infra/compose.yaml)
DATABASE_URL=postgres://brain:brain@127.0.0.1:5433/ai_second_brain?sslmode=disable
# Test database used by pytest and e2e (created by `just db::test-prepare`)
TEST_DATABASE_URL=postgres://brain:brain@127.0.0.1:5433/ai_second_brain_test?sslmode=disable

# Owner login. Run `just hash-password` and paste the printed line here.
# KEEP THE SINGLE QUOTES: unquoted '$' characters are expanded by just's .env loader.
SB_OWNER_PASSWORD_HASH=''
SB_SESSION_TTL_DAYS=14
SB_COOKIE_SECURE=false
SB_ALLOWED_ORIGINS=http://localhost:5173
SB_API_PORT=8000
SB_WEB_PORT=5173
# dev enables /api/docs; prod disables it
SB_ENV=dev
# Optional: use a globally installed dbmate instead of the npm one (scoop/winget/brew)
# DBMATE=dbmate

# Private chat: Ollama endpoints in order of preference (JSON, single-quoted).
# "degraded": true labels answers "Private — small local model" (e.g. a CPU-only host).
# A "local" endpoint is whatever URL you put here: keep it on your own LAN.
# SB_OLLAMA_ENDPOINTS='[{"label":"workstation","url":"http://192.168.88.10:11434","model":"qwen3:32b"},{"label":"proxmox","url":"http://192.168.88.20:11434","model":"qwen3:8b","degraded":true}]'
# Cloud chat (explicit opt-in per session). Empty = cloud mode disabled.
SB_ANTHROPIC_API_KEY=
# SB_ANTHROPIC_MODEL=claude-sonnet-5-5
# Pinned to the real API; the ANTHROPIC_BASE_URL env var is ignored. Tests override this.
# SB_ANTHROPIC_BASE_URL=https://api.anthropic.com
# SB_CHAT_MAX_TOKENS=2048
# Seconds to cache /api/chat/status endpoint probes.
# SB_CHAT_STATUS_TTL_SECONDS=10

# Vault ingestion (Phase 2a). Absolute path; empty = ingestion disabled.
# SB_VAULT_PATH=C:\Users\me\Documents\Obsidian\Vault
# Comma-separated glob patterns (vault-relative, forward slashes) to skip. Only *.md is read.
# SB_VAULT_EXCLUDE=.obsidian/**,.trash/**,**/.git/**
# Embedding host (Ollama). Empty = the first SB_OLLAMA_ENDPOINTS URL. Run `ollama pull bge-m3` there.
# Prefer 127.0.0.1 over localhost on Windows (localhost tries IPv6 first and can stall).
# SB_EMBED_URL=http://127.0.0.1:11434
# Exact Ollama tag (see `ollama list`), e.g. bge-m3:567m. Hosted ":cloud" models are refused.
# SB_EMBED_MODEL=bge-m3
# SB_EMBED_BATCH=16
# SB_RECONCILE_MINUTES=15
# SB_MAX_NOTE_BYTES=2000000

# Search, chat and capture (Phase 2b)
# Vault-relative folder for captured notes (inside the vault, not excluded). Written by the API.
# SB_CAPTURE_DIR=Inbox
# Vault name in obsidian:// links. Empty = the basename of SB_VAULT_PATH.
# SB_OBSIDIAN_VAULT=
# Context window requested from Ollama for chat (2048 to 131072).
# SB_CHAT_NUM_CTX=8192
# Vector matches below this similarity are not used as chat sources (0 to 1).
# SB_RETRIEVAL_MIN_SIMILARITY=0.45

# Embedding evaluation (Phase 3). Run `just eval-suggest --out <file>`, then `just eval-check` and `just eval-run`.
# Your questions. Private: keep it outside the repo.
# SB_EVAL_QUERIES=~/.second-brain/eval/queries.yaml
# Reports (report.md, results.json). Private; refused if inside the repo.
# SB_EVAL_DIR=~/.second-brain/eval/reports
# Scratch database. Default: DATABASE_URL with "_eval" added to the name. Never the dev or test database.
# SB_EVAL_DATABASE_URL=
# Comma-separated Ollama tags; the first is the incumbent (your SB_EMBED_MODEL tag replaces it).
# SB_EVAL_MODELS=bge-m3,snowflake-arctic-embed2,granite-embedding:278m,paraphrase-multilingual

# Knowledge graph (Phase 4a). Extraction is local only; run `just graph-extract`, then review in the web app.
# Local Ollama tag for extraction. Empty = the model of the first SB_OLLAMA_ENDPOINTS entry. ":cloud" tags are refused.
# SB_EXTRACT_MODEL=
# Minimum confidence (0 to 1) to auto-accept a link to an entity you already accepted.
# SB_EXTRACT_AUTO_ACCEPT=0.8
# Minimum name-embedding similarity (0 to 1) to link a new name to an existing entity.
# SB_ENTITY_MATCH_SIMILARITY=0.90
# Max characters of note text per model call (2000 to 32000). It must fit SB_CHAT_NUM_CTX
# (about 3 characters per token, plus the prompt and the answer; ~16000 fits 8192); the worker warns if not.
# SB_EXTRACT_WINDOW_CHARS=6000

# Nightly run and morning digest (Phase 4b). The worker re-extracts new, changed and failed notes each night.
# Set false to stop the schedule (Run now and `just nightly` still work). The e2e harness sets false.
# SB_NIGHTLY_ENABLED=true
# Local time to start the run, HH:MM (24 h), 00:00 to 23:45 (the schedule is checked every 15 minutes).
# SB_NIGHTLY_AT=02:00
# IANA zone for SB_NIGHTLY_AT, e.g. Europe/Warsaw. Empty = this host's zone (daylight saving respected).
# SB_TIMEZONE=
# Most notes one run queues (1 to 100000).
# SB_NIGHTLY_MAX_NOTES=500
# Hours after which a run stops waiting for its extraction jobs (1 to 48).
# SB_NIGHTLY_MAX_HOURS=8
